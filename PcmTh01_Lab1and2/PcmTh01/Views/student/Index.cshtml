@model IEnumerable<PcmTh01.Models.Student>
@using PcmTh01.Models

@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<h2>Danh sách sinh viên</h2>

<p>
    <a asp-route="student-add" class="btn btn-primary">
        Create Student
    </a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Mã</th>
            <th>Họ tên</th>
            <th>Ngày sinh</th>
            <th>Ngành</th>
            <th>Giới tính</th>
            <th>Hệ ĐT</th>
            <th>Địa chỉ</th>
            <th>Email</th>
            <th>Điểm</th>
            <th>Ảnh sinh viên</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.Name</td>
                <td>@s.DateOfBorth</td>

                <td>
                    @{
                        string str = "";

                        switch (s.Branch)
                        {
                            case Branch.IT:
                                str = "CNTT";
                                break;
                            case Branch.BE:
                                str = "Kinh tế";
                                break;
                            case Branch.CE:
                                str = "Công trình";
                                break;
                            case Branch.EE:
                                str = "Điện - Điện tử";
                                break;
                        }
                    }
                    @str
                </td>

                <td>@(s.Gender == Gender.Male ? "Nam" : "Nữ")</td>
                <td>@(s.IsRegular ? "Chính quy" : "Phi chính quy")</td>
                <td>@s.Address</td>
                <td>@s.Email</td>
                
                <td>@s.Score</td>

                <td>
                    @if (!string.IsNullOrEmpty(s.Image))
                    {
                        <img src="~/images/@s.Image"
                             alt="Ảnh sinh viên"
                             width="80"
                             height="80"
                             style="object-fit: cover;" />
                    }
                    else
                    {
                        <span>Chưa có ảnh</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        var table = document.querySelector("table");
        table.onclick = function onTableClick() {
            table.style = "background-color: yellow;";
        }
    </script>
}