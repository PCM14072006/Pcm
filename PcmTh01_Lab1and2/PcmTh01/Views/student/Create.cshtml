@model PcmTh01.Models.Student
@using PcmTh01.Models

@{
    ViewData["Title"] = "Create Student";
}

<div>
    <h2>Thêm sinh viên</h2>

    <form asp-route="student-add"
          method="post"
          enctype="multipart/form-data"
          class="mt-3">

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Name" class="col-sm-2 col-form-label">Họ tên</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Họ tên" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="PassWord" class="col-sm-2 col-form-label">Mật khẩu</label>
            <div class="col-sm-10">
                <input asp-for="PassWord" type="password" class="form-control" placeholder="Password" />
                <span asp-validation-for="PassWord" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Branch" class="col-sm-2 col-form-label">Ngành</label>
            <div class="col-sm-10">
                <select asp-for="Branch"
                        asp-items="Html.GetEnumSelectList<Branch>()"
                        class="form-control">
                    <option value="">-- Chọn ngành --</option>
                </select>
                <span asp-validation-for="Branch" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="IsRegular" class="col-sm-2 col-form-label">Hệ đào tạo</label>
            <div class="col-sm-10">
                <div class="form-check">
                    <input asp-for="IsRegular" class="form-check-input" />
                    <label asp-for="IsRegular" class="form-check-label">
                        Sinh viên chính quy
                    </label>
                </div>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="DateOfBorth" class="col-sm-2 col-form-label">Ngày sinh</label>
            <div class="col-sm-10">
                <input asp-for="DateOfBorth" type="date" class="form-control" />
                <span asp-validation-for="DateOfBorth" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Gender" class="col-sm-2 col-form-label">Giới tính</label>
            <div class="col-sm-10">
                @foreach (Gender gender in ViewBag.AllGenders)
                {
                    <div class="form-check">
                        <input type="radio"
                               asp-for="Gender"
                               value="@gender"
                               id="Gender_@gender"
                               class="form-check-input" />
                        <label for="Gender_@gender" class="form-check-label">
                            @(gender == Gender.Male ? "Nam" : "Nữ")
                        </label>
                    </div>
                }
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>
        </div>

        <div style="margin-top:7px" class="form-group row">
            <label asp-for="Address" class="col-sm-2 col-form-label">Địa chỉ</label>
            <div class="col-sm-10">
                <textarea asp-for="Address" class="form-control" placeholder="Địa chỉ"></textarea>
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>
        </div>

        <!-- Chọn ảnh sinh viên -->
        <div style="margin-top:7px" class="form-group row">
            <label class="col-sm-2 col-form-label">Ảnh sinh viên</label>
            <div class="col-sm-10">
                <input type="file"
                       name="imageFile"
                       class="form-control"
                       accept=".jpg,.jpeg,.png" />
            </div>
        </div>

        <div style="margin-top:10px" class="form-group row">
            <div class="col-sm-10 offset-sm-2">
                <button type="submit" class="btn btn-primary">Create</button>
                <a asp-route="student-list" class="btn btn-secondary">Quay lại</a>
            </div>
        </div>

    </form>
</div>
