@model IEnumerable<PcmLesson04.Models.Book>

<style>
    .book-image {
        width: 100%;
        height: 300px;
        object-fit: contain;
    }
</style>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-3">
            <div class="thumbnail">
                <img src="@item.Image" alt="@item.Title" class="book-image" />

                <div class="caption">
                    <h3>@item.Title</h3>

                    <p>
                        Price: @item.Price
                    </p>
                </div>
            </div>
        </div>
    }
</div>