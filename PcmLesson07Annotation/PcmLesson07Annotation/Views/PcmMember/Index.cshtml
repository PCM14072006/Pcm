@model IEnumerable<PcmLesson07Annotation.Models.PcmMember>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PcmUsername)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pcmpassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PcmEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PcmPhone)
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PcmUsername)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Pcmpassword)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PcmEmail)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.PcmPhone)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>